{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop permissions for the main Distill window.",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "updater:default",
    "allow-load-store-json",
    "allow-load-vault-json",
    "allow-save-vault-json",
    "allow-reset-encrypted-vault",
    "allow-load-vault-record-log-json",
    "allow-save-vault-record-log-json",
    "allow-clear-plain-store",
    "allow-load-storage-info-json",
    "allow-start-update-installer",
    "allow-write-encrypted-sync-packet-file",
    "allow-list-encrypted-sync-packet-files",
    "allow-read-encrypted-sync-packet-file",
    "allow-quarantine-encrypted-sync-packet-file",
    "allow-save-sync-recovery-vault-json",
    "allow-list-sync-recovery-vault-files",
    "allow-read-sync-recovery-vault-file",
    "allow-emit-ai-org-event"
  ]
}
